    <string name="dev_custom_warn_scale">拉伸超过 1.3 倍：画面会变模糊</string>
    <string name="dev_custom_warn_transcode">重新编码已关闭：将使用 1280×720</string>
    <string name="dev_custom_note">仅在重新编码时有效。</string>

