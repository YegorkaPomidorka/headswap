    <string name="step_aa_dev_primary">فتح Android Auto</string>
    <string name="step_aa_dev_short">وضع المطوّر في Android Auto</string>

    <string name="step_aa_unknown_title">اسمح بالتثبيت من مصادر غير معروفة</string>
    <string-array name="step_aa_unknown_list">
