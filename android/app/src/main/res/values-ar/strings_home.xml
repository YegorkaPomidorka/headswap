    <!-- Home screen: hero subtitles -->
    <string name="home_err_no_cert">لا توجد شهادة شاشة السيارة في نسخة التطبيق.</string>
    <string name="home_sub_start_chain">فعّله مرة واحدة: بعدها يستمر الخادم بالعمل في الخلفية، ولا حاجة لفتح قفل الهاتف للاتصال.</string>
    <string name="home_sub_reconnecting">انقطع اتصال USB. تنتظر جلسة Android Auto حتى %1$d ث.</string>
    <string name="home_sub_ok">Android Auto على شاشة السيارة. يمكنك وضع الهاتف جانبًا.</string>
    <string name="home_sub_ok_wifi">Android Auto على شاشة السيارة عبر Wi-Fi، بلا كابل. يمكنك وضع الهاتف جانبًا.</string>
    <string name="home_sub_refused">كابل USB متصل، لكن خادم شاشة السيارة لا يردّ. %1$s</string>
    <string name="home_sub_aa_dropped">انقطع اتصال Android Auto. شغّل خادم شاشة السيارة مرة أخرى.</string>
    <string name="home_sub_cable_ok">كابل USB متصل. بانتظار Android Auto.</string>
    <string name="home_sub_parked">بقي خادم شاشة السيارة يعمل في الخلفية. في الرحلة القادمة، يكفي توصيل الكابل.</string>
    <string name="home_sub_server_down">أغلق Android خادم شاشة السيارة. شغّله مرة أخرى: Android Auto ← ⋮ ← «بدء تشغيل خادم الوحدة الرئيسية».</string>
    <string name="home_sub_ready">وصّل الهاتف بشاشة السيارة بكابل USB.</string>
    <string name="home_sub_unknown">تعذّر على Headswap فحص الخادم. في Android Auto ← ⋮: إذا ظهر «إيقاف خادم الوحدة الرئيسية» فهو يعمل، وإذا ظهر «بدء تشغيل خادم الوحدة الرئيسية» فشغّله.</string>
    <string name="home_sub_checking">ثوانٍ قليلة: يتصل Headswap بـ Android Auto لفترة وجيزة.</string>
    <string name="home_sub_parked_unknown">في الرحلة القادمة: وصّل الكابل. إذا لم يظهر Android Auto، تحقق من خادم شاشة السيارة: Android Auto ← ⋮.</string>

