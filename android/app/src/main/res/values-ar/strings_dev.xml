    <string name="dev_section_meta">بيانات التعريف على شاشة السيارة (تُطبَّق بعد إعادة اتصال USB)</string>
    <string name="dev_meta_music_title">الموسيقى</string>
    <string name="dev_meta_music_sub">المقطع والغلاف والتقدّم: MEDIA_INFO / MEDIA_PROGRESS_BAR</string>
    <string name="dev_meta_navi_title">الملاحة</string>
    <string name="dev_meta_navi_sub">المنعطفات والمسافة: NAVI_NEXT_TURN_INFO عند اشتراك شاشة السيارة</string>
    <string name="dev_meta_icon_title">الحقل 6: الأيقونة</string>
    <string name="dev_meta_icon_sub">bytes turnIconData، سهم PNG (مثل Baidu 8.6.7)</string>
    <string name="dev_meta_time_title">الحقل 6: time</string>
    <string name="dev_meta_time_sub">int32 time حتى المناورة، بالثواني (مثل apollo-DuerOS)</string>
    <string name="dev_meta_progress_title">التقدّم بالثواني</string>
    <string name="dev_meta_progress_sub">MEDIA_PROGRESS_BAR بالثواني بدل المللي ثانية (إذا عرضت شاشة السيارة قيمة أكبر 1000 مرة)</string>

    <string name="dev_section_music_chunk">حجم حزمة الموسيقى (تجريبي)</string>
    <string name="dev_music_chunk_note">كلما صغر الحجم صغرت الذاكرة المؤقتة في شاشة السيارة وزادت الحزم عبر USB. إذا تقطّع الصوت، فارجع إلى «كما يرسله Android Auto»</string>
    <string name="dev_section_voice_chunk">حجم حزمة الصوت (تجريبي)</string>
    <string name="dev_voice_chunk_note">ردود المساعد وتنبيهات الملاحة. تلقائي: 1024 B على VW CNS2 Delphi، وفي غيره كما يرسله AA</string>
    <string name="dev_section_tts_preroll">صمت قبل التنبيه (تجريبي)</string>
    <string name="dev_tts_preroll_note">أصفار بعد بدء التنبيه لتتمكّن شاشة السيارة من فتح مسار الصوت. تلقائي: 400 مللي ثانية على VW</string>
    <string name="dev_section_touch_decimation">تقليل أحداث اللمس (تجريبي)</string>
    <string name="dev_touch_decimation_note">تخطّي كل حدث MOVE ثانٍ: ترسل شاشة السيارة حتى ~70 حدثًا في الثانية، والفيديو يعمل حتى 30 FPS. آخر نقطة قبل رفع الإصبع لا تُفقد أبدًا.</string>


    <string name="dev_section_video">الفيديو (يُطبَّق عند إعادة الاتصال)</string>
    <string name="dev_own_idr_title">إطار رئيسي خاص في التمرير المباشر</string>
    <string name="dev_own_idr_sub">كل 2 ث يرسل الهاتف إلى شاشة السيارة إطارًا رئيسيًا خاصًا به: تعود الصورة بعد كاميرا الرجوع وقائمة السيارة. أوقفه إذا كانت شاشة السيارة تتعافى وحدها (مثل VW): حركة بيانات وحمل أقل على الهاتف</string>
    <string name="dev_video_time_ms_title">توقيت حزمة الفيديو بالمللي ثانية</string>
    <string name="dev_video_time_ms_sub">تجربة: حقل time في VIDEO_DATA بالمللي ثانية (مثل الموسيقى) بدل الثواني. فعّله إذا كان الفيديو على شاشة السيارة يتقطع أو يتجمد؛ أوقفه إذا ساء الوضع</string>
    <string name="dev_custom_res_title">دقة خاصة</string>
    <string name="dev_custom_res_sub">بدلًا من الوضع في إعدادات الفيديو</string>
    <string name="dev_section_desktop">سطح المكتب على شاشة السيارة</string>
    <string name="dev_hide_status_title">إخفاء شريط الحالة</string>
    <string name="dev_hide_status_sub">لشاشات السيارة التي تعرض في الأعلى شريطها الخاص بالساعة والأيقونات (بعض سيارات VW). تظهر الإشعارات كنتوء بخط ذهبي: اسحب للأسفل لفتح لوحة الإشعارات</string>
