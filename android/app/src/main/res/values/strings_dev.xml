<resources>
    <string name="dev_title">For developers</string>

    <string name="dev_section_mic">Head unit microphone</string>
    <string name="dev_mic_vr_title" translatable="false">MODULE_STATUS VR</string>
    <string name="dev_mic_vr_sub">Send VR 1/0 together with MIC_RECORD_* (like Baidu)</string>

    <string name="dev_section_meta">Metadata on the head unit (applies after USB reconnect)</string>
    <string name="dev_meta_music_title">Music</string>
    <string name="dev_meta_music_sub">Track, cover and progress: MEDIA_INFO / MEDIA_PROGRESS_BAR</string>
    <string name="dev_meta_navi_title">Navigation</string>
    <string name="dev_meta_navi_sub">Turns and distance: NAVI_NEXT_TURN_INFO when the head unit subscribes</string>
    <string name="dev_meta_icon_title">Field 6: icon</string>
    <string name="dev_meta_icon_sub">bytes turnIconData, PNG arrow (like Baidu 8.6.7)</string>
    <string name="dev_meta_time_title">Field 6: time</string>
    <string name="dev_meta_time_sub">int32 time to the maneuver, s (like apollo-DuerOS)</string>
    <string name="dev_meta_progress_title">Progress in seconds</string>
    <string name="dev_meta_progress_sub">MEDIA_PROGRESS_BAR in s instead of ms (if the head unit shows 1000× too much)</string>

    <string name="dev_section_music_chunk">Music packet size (experimental)</string>
    <string name="dev_music_chunk_note">Smaller means a smaller buffer on the head unit but more packets over USB. If the sound stutters, switch back to “As Android Auto sends it”</string>
    <string name="dev_section_voice_chunk">Voice packet size (experimental)</string>
    <string name="dev_voice_chunk_note">Assistant replies and navigation prompts. Auto: 1024 B on VW CNS2 Delphi, otherwise as AA sends it</string>
    <string name="dev_section_tts_preroll">Silence before prompt (experimental)</string>
    <string name="dev_tts_preroll_note">Zeros after the prompt starts, so the head unit can open the audio path. Auto: 400 ms on VW</string>
    <string name="dev_section_touch_decimation">Touch decimation (experimental)</string>
    <string name="dev_touch_decimation_note">Skip every second MOVE: the head unit sends up to ~70 events per second, video runs at up to 30 fps. The last point before the finger lifts is never lost.</string>


