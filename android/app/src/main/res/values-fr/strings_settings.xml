    <string name="set_aa_density_manual_sub">manuel, auto pour cette résolution : %1$d</string>
    <string name="set_aa_density_reset">Auto</string>
    <string name="set_aa_density_smaller">Plus petit</string>
    <string name="set_aa_density_larger">Plus grand</string>
    <string name="set_aa_density_note">Plus le dpi est élevé, plus l\'affichage est grand. S\'applique à la prochaine connexion. Avec un dpi élevé, Android Auto peut changer de disposition : une seule colonne au lieu de l\'écran partagé.</string>
