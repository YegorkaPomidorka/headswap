    <string name="set_music_rate">Fréquence d\'échantillonnage de la musique</string>
    <string name="set_music_rate_note">Fréquence plus basse : moins de charge sur la liaison USB et sur les autoradios peu puissants, mais qualité réduite. Auto : 48 kHz, 32 kHz pour les autoradios Hyundai CN7. S\'applique à la prochaine connexion.</string>
    <string name="set_fps">Fréquence d\'images</string>
    <string name="set_fps_note">S\'applique à la prochaine connexion. En transmission directe, la fréquence d\'images ne peut pas être modifiée.</string>
    <string name="set_fps_direct">En transmission directe, Android Auto définit la fréquence d\'images</string>
    <string name="set_aa_density">Échelle de l\'interface Android Auto</string>
    <string name="set_aa_density_auto">Auto · %1$d dpi</string>
