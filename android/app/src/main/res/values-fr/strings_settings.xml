    <string name="set_video">Vidéo</string>
    <string name="set_transcode_title">Réencodage</string>
    <string name="set_transcode_desc">Votre téléphone réencode la vidéo pour l\'écran de l\'autoradio : toute résolution et toute fréquence d\'images.</string>
    <string name="set_transcode_plus">+ Plus stable, fonctionne avec n\'importe quel autoradio</string>
    <string name="set_transcode_minus">− Charge sur le téléphone, consommation de batterie, latence +60 ms</string>
    <string name="set_direct_title">Transmission directe</string>
    <string name="set_direct_desc">La vidéo d\'Android Auto est envoyée telle quelle à l\'autoradio. Les écrans larges sont rognés par l\'autoradio lui-même.</string>
    <string name="set_direct_plus">+ Latence, échauffement et consommation de batterie réduits</string>
    <string name="set_direct_minus">− La fréquence d\'images n\'est pas réglable</string>
    <string name="set_direct_desktop_desc">En mode « Lanceur intégré », le téléphone capture le bureau et l’encode une seule fois ; ce n’est pas un transcodage Android Auto.</string>
    <string name="set_desktop_single_encode_title">Encodage unique de l’écran</string>
    <string name="set_desktop_fps_title">Fréquence d’images du bureau</string>
    <string name="set_desktop_fps_note">S’applique à la prochaine connexion. « Auto » choisit 30 i/s sauf si l’autoradio demande moins.</string>

